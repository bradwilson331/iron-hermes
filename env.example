# =============================================================================
# IronHermes Environment Variables
# =============================================================================
# Copy to ~/.ironhermes/.env and uncomment the values you need.
# See cli-config.yaml.example for YAML-based configuration.

# =============================================================================
# LLM Providers
# =============================================================================

# --- OpenRouter (default provider) ---
# OPENROUTER_API_KEY=sk-or-...

# --- Anthropic (direct API) ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- Google / Gemini ---
# GOOGLE_API_KEY=
# GEMINI_API_KEY=

# --- OpenAI ---
# OPENAI_API_KEY=sk-...

# --- Ollama (local or cloud) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_API_KEY=

# --- Groq ---
# GROQ_API_KEY=gsk_...

# --- Together AI ---
# TOGETHER_API_KEY=

# --- Mistral ---
# MISTRAL_API_KEY=

# --- Perplexity ---
# Also `web_answer`'s first-position provider (Phase 41.3) — see the
# "Tool API Keys" section below and docs/CONFIGURATION.md for the full
# web-tool provider chain. Optional there too: web_answer works with no key
# via DuckDuckGo.
# PERPLEXITY_API_KEY=

# --- DeepSeek ---
# DEEPSEEK_API_KEY=

# --- Fireworks AI ---
# FIREWORKS_API_KEY=

# =============================================================================
# Tool API Keys
# =============================================================================

# --- Web-tool providers (Phase 41.3) ---
# Every key in this group is OPTIONAL. Each web tool tries its configured
# providers in order (tools.<tool>.chain in cli-config.yaml.example) and
# falls through to the next on a missing key or a failed call. DuckDuckGo
# needs no key and terminates the default chain for BOTH web_search and
# web_answer, so neither tool ever hard-fails on a fresh install — setting a
# key here only selects a higher-quality provider earlier in the chain, it
# is never required just to use the tool. See docs/CONFIGURATION.md for the
# full precedence chain, the legal provider names, and how to reorder them.
#   web_search  (results list):        exa > brave > tavily > ddg (keyless)
#   web_answer  (synthesized answer):  perplexity > exa > brave > ddg (keyless)
#   web_extract (page content):        firecrawl > exa > tavily > local (keyless)
# (PERPLEXITY_API_KEY lives in the LLM Providers section above — it doubles
# as an inference provider key.)

# --- Firecrawl (web scraping backend — web_extract) ---
# FIRECRAWL_API_KEY=fc-...

# --- Exa (web_search / web_answer / web_extract) ---
# EXA_API_KEY=

# --- Tavily (web_search / web_extract) ---
# TAVILY_API_KEY=

# --- Brave Search (web_search / web_answer) ---
# BRAVE_API_KEY=

# --- fal.ai (image_gen tool) ---
# Required to enable the `image_gen` text-to-image tool. When unset, the tool is
# completely hidden from the LLM (no fal client is built, zero startup cost). The
# key is resolved lazily at call time and never logged. Get one at https://fal.ai/dashboard/keys
# NOTE: FAL_KEY alone is not enough — image_gen lives in the `web` toolset, which
# is disabled by default. Also set tools.toolsets.web.enabled: true in config.yaml.
# FAL_KEY=

# =============================================================================
# Terminal / Sandbox Configuration
# =============================================================================

# Sandbox backend: "local" (default) or "docker" (future)
# TERMINAL_BACKEND=local

# Default working directory for agent tool operations
# TERMINAL_CWD=.

# Command execution timeout in seconds (default: 30)
# TERMINAL_TIMEOUT=30

# Docker sandbox image (when TERMINAL_BACKEND=docker)
# TERMINAL_DOCKER_IMAGE=ironhermes-sandbox:latest

# Comma-separated env vars to pass through to sandbox
# TERMINAL_ENV=HOME,USER,PATH

# =============================================================================
# Code Execution (execute_code tool)
# =============================================================================

# Path to Python interpreter (default: python3)
# EXEC_PYTHON_PATH=python3

# Execution timeout in seconds (default: 300)
# EXEC_TIMEOUT_SECS=300

# =============================================================================
# IronHermes Home Directory
# =============================================================================

# Override the default data directory (default: ~/.ironhermes)
# IRONHERMES_HOME=~/.ironhermes

# =============================================================================
# Gateway -- Telegram
# =============================================================================

# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=123456789,987654321
# TELEGRAM_HOME_CHANNEL=

# =============================================================================
# Gateway -- Discord
# =============================================================================
# Shipped in Phase 34. Built on serenity 0.12.5. Requires the MESSAGE_CONTENT
# privileged gateway intent (toggle in the Discord developer portal under
# Applications → your app → Bot → Privileged Gateway Intents).
# Allowed user IDs live in gateway.platforms.discord.whitelist in config.yaml
# (Vec<i64> of Discord snowflakes). Empty whitelist = deny all.
# See docs/MULTI-PLATFORM-GATEWAY.md for full setup.

# DISCORD_BOT_TOKEN=

# =============================================================================
# Gateway -- Slack
# =============================================================================
# Shipped in Phase 34. Built on slack-morphism 2.22.0 Socket Mode. Requires
# BOTH tokens to be set (Pitfall 2 — Slack adapter silently skips otherwise):
#   - SLACK_BOT_TOKEN  : Bot User OAuth Token (xoxb-...) for Web API calls
#   - SLACK_APP_TOKEN  : App-level token (xapp-...) with `connections:write`
#                        scope, used to establish the Socket Mode WebSocket
# Configure the Slack app at https://api.slack.com/apps — enable Socket Mode,
# subscribe to bot events (message.im, message.channels, app_mention, ...),
# add chat:write / im:history / channels:history OAuth scopes.
# See docs/MULTI-PLATFORM-GATEWAY.md for the full token-acquisition flow.
# NOTE: Slack channel IDs are alphanumeric (C..., D..., U...) but the
# shared whitelist field is currently Vec<i64> — see the caveat in
# docs/MULTI-PLATFORM-GATEWAY.md "Slack whitelist caveat".

# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# =============================================================================
# MCP Servers (future)
# =============================================================================

# MCP_CONFIG_PATH=~/.ironhermes/mcp-servers.yaml

# =============================================================================
# Browser / Browserbase (future)
# =============================================================================

# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=

# =============================================================================
# Debug Flags
# =============================================================================

# WEB_TOOLS_DEBUG=false
# VISION_TOOLS_DEBUG=false
# RUST_LOG=ironhermes=info
