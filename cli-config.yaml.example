# =============================================================================
# IronHermes Configuration
# =============================================================================
# Copy to ~/.ironhermes/config.yaml and customize.
# Values shown are defaults -- uncomment and change as needed.
# Environment variables in .env override matching config values.

# --- Model Configuration ---
model:
  # Default model identifier
  # default: "anthropic/claude-sonnet-5"

  # LLM provider: openrouter, anthropic, openai, ollama, google, together, mistral, groq, deepseek, fireworks
  # provider: "openrouter"

  # Override API base URL (usually not needed)
  # base_url: null

  # DEPRECATED — use providers.<name>.api_key_env instead (see "Provider Overrides" below).
  # Kept one release for backwards compat; emits a deprecation banner at startup.
  # api_key: null

  # Vision model for image analysis (null = use default model)
  # vision_model: null

  # Maximum tokens per response (null = provider default)
  # max_tokens: null

  # Model context window size (null = auto-detect from model metadata)
  # context_length: null

  # Auxiliary model role assignments (provider + optional model override)
  # roles:
  #   vision:
  #     provider: "openrouter"
  #     model: "openai/gpt-4o"
  #   compression:
  #     provider: "main"    # "main" inherits the primary provider

# --- Agent Configuration ---
agent:
  # Maximum agent loop iterations per turn (default: 50)
  # Lowered from 90 to bound runaway-delegation cost — pairs with the
  # AgentLoop's consecutive-failure circuit breaker. Raise deliberately
  # if you need longer multi-step reasoning chains.
  # max_turns: 50

  # Context compression ratio (default: 0.5)
  # context_compression: 0.5

  # Delay between tool calls in seconds (default: 1.0)
  # tool_delay_secs: 1.0

  # Context engine: "summarizing" (default, uses LLM) or "local_prune" (heuristic)
  # context_engine: "summarizing"

  # Compression threshold as fraction of context_length (default: 0.5)
  # compression_threshold: 0.5

  # Phase 36.3.8 (D-06): maximum seconds a suspended `clarify` tool waits for a
  # human button response before returning a timeout sentinel
  # ({"answered":false,"reason":"timeout"}). Bounds how long an unanswered
  # clarify can pin a turn slot. Default: 120 (2 minutes).
  # clarify_timeout_secs: 120

  # Optional system message injected into prompt (empty = omitted)
  # system_message: ""

  # Custom personality presets (name -> system prompt text)
  # personalities:
  #   pirate: "You are a helpful pirate assistant. Arr!"

# --- Terminal / Sandbox ---
terminal:
  # Exec backend for the `terminal` and `execute_code` tools.
  # "local" (default) | "docker" | "ssh". Config-only (D-06) — no LLM/tool
  # argument can change it. An unavailable/misconfigured backend HARD-ERRORS
  # rather than silently falling back to local (D-05).
  # backend: "local"

  # Default working directory for agent tool operations
  # "." means current directory; set to "~/.ironhermes/workspace" for isolation
  # cwd: "."

  # Command execution timeout in seconds (default: 30)
  # timeout: 30

  # Env var names passed through to the LOCAL terminal subprocess, on top of
  # the base safe-env set (Phase 42 D-05). Local-only; distinct from forward_env.
  # terminal_env_allowlist: []
  # terminal_env_allowlist: [KUBECONFIG, AWS_PROFILE]

  # --- docker backend (only consulted when backend: docker) ---
  # Container CLI to shell out to. Explicit, never auto-detected by probing
  # PATH (D-07). "docker" (default) | "podman".
  # container_runtime: "docker"

  # Base image for the docker backend's persistent container.
  # image: "debian:stable-slim"

  # Orphan-reaper "lifetime" (seconds): the boot-time reaper GCs labeled
  # containers idle longer than 2x this value (D-02). Default 86400 (24h).
  # container_reap_after_secs: 86400

  # docker backend resource limits / persistence / networking.
  # container:
  #   cpu: 1.0            # fractional cores
  #   memory_mib: 5120    # 5 GiB
  #   disk_mib: 51200     # 50 GiB (workspace bind-mount/tmpfs cap)
  #   pids_limit: 256
  #   persistent: true    # bind-mount /workspace (survives recreation) vs tmpfs
  #   network: false      # false -> --network=none (security-hardened default)

  # --- shared docker/ssh boundary ---
  # Credential/env allowlist forwarded ACROSS the docker/ssh backend boundary
  # (D-09). Empty = nothing secret crosses unless opted in by name.
  # forward_env: []
  # forward_env: [KUBECONFIG, AWS_PROFILE]

  # --- ssh backend (only consulted when backend: ssh) ---
  # No meaningful defaults for host/user — the ssh backend cannot be
  # constructed without them (else create_environment hard-errors per D-05).
  # ssh:
  #   host: "example.internal"
  #   user: "deploy"
  #   port: 22
  #   key_path: null      # null uses the ssh CLI's default identity resolution

# --- Web Tools ---
web:
  # Web scraping backend: "firecrawl" (default) or "raw"
  # backend: "firecrawl"

  # User-Agent header for HTTP requests
  # user_agent: "IronHermes/1.0 (+bot)"

  # Maximum content length in characters before truncation (default: 50000)
  # max_content_chars: 50000

  # HTTP request timeout in seconds (default: 30)
  # timeout_secs: 30

# --- Code Execution ---
exec:
  # Path to Python interpreter (default: "python3")
  # python_path: "python3"

  # Execution timeout in seconds (default: 300 = 5 minutes)
  # timeout_secs: 300

  # Maximum RPC calls per execution (default: 50)
  # max_rpc_calls: 50

  # Maximum stdout bytes before truncation (default: 50000)
  # max_output_bytes: 50000

  # Maximum stderr bytes before truncation (default: 10240)
  # max_stderr_bytes: 10240

# --- Gateway ---
gateway:
  # Context engine for gateway sessions (default: "local_prune")
  # context_engine: "local_prune"

  # Compression threshold for gateway (default: 0.85)
  # compression_threshold: 0.85

  # Platform adapters
  # The `platforms:` map is empty by default. Each platform key (telegram,
  # discord, slack) is independent — missing config sections SILENTLY SKIP at
  # gateway startup, so existing Telegram-only deployments don't change. For
  # any platform, both the config section AND a resolved token must be present
  # for the listener to spawn. See docs/MULTI-PLATFORM-GATEWAY.md for the full
  # operator guide (token acquisition, intents, Socket Mode setup).
  # platforms:
  #   telegram:
  #     # Enable Telegram gateway (informational; resolved token is the gate)
  #     enabled: true
  #
  #     # Bot token. Prefer the TELEGRAM_BOT_TOKEN env var (in ~/.ironhermes/.env)
  #     # over inlining the secret here. If both are set, env var wins.
  #     # token: "123456:ABC-DEF..."
  #
  #     # Allowed Telegram chat IDs (Vec<i64>). Empty list = deny all.
  #     # Get your chat ID by messaging @userinfobot on Telegram.
  #     whitelist: [123456789]
  #
  #     # Phase 36.3.8 (D-01): explicit home channel the agent `send_message`
  #     # tool delivers to when given the bare `telegram` target. Quoted string
  #     # (Option<String>), numeric chat ID only. When omitted (null) and the
  #     # whitelist has exactly ONE entry, that entry is used automatically;
  #     # when omitted and the whitelist has 0 or 2+ entries, send_message
  #     # returns an "ambiguous home channel" error. The resolved channel is
  #     # ALSO validated against this whitelist before dispatch (code-review
  #     # CR-02 fix), so home_channel_id MUST be a whitelist member.
  #     # home_channel_id: "123456789"
  #
  #     # Session inactivity timeout in hours (default: 24)
  #     # session_timeout_hours: 24
  #
  #     # Maximum concurrent agent runs (default: 8)
  #     # max_concurrent_runs: 8
  #
  #   # --- Discord (Phase 34, serenity 0.12.5) ---
  #   # Requires MESSAGE_CONTENT privileged gateway intent toggled on in the
  #   # Discord developer portal. Token resolves from inline value OR
  #   # DISCORD_BOT_TOKEN env var (Discord-specific; never picks up
  #   # TELEGRAM_BOT_TOKEN).
  #   discord:
  #     enabled: true
  #     # token: "YOUR.DISCORD.BOT.TOKEN"
  #
  #     # Allowed Discord user IDs (Vec<i64> snowflakes). Empty = deny all.
  #     # Enable Developer Mode in Discord settings, right-click a user →
  #     # "Copy User ID" to find your own snowflake.
  #     whitelist: [987654321]
  #
  #     # session_timeout_hours: 24
  #     # max_concurrent_runs: 8
  #
  #   # --- Slack (Phase 34, slack-morphism 2.22.0 Socket Mode) ---
  #   # Requires BOTH a bot token (xoxb-...) and an app-level token (xapp-...
  #   # with `connections:write` scope). The Slack listener silently skips
  #   # unless both resolve (Pitfall 2). Tokens fall back to SLACK_BOT_TOKEN
  #   # and SLACK_APP_TOKEN env vars respectively.
  #   slack:
  #     enabled: true
  #     # token: "xoxb-..."        # Bot User OAuth Token
  #     # app_token: "xapp-..."    # App-Level Token, connections:write scope
  #
  #     # NOTE: Slack channel IDs are alphanumeric (C..., D..., U...) but
  #     # this whitelist is Vec<i64> for now — see the caveat in
  #     # docs/MULTI-PLATFORM-GATEWAY.md "Slack whitelist caveat".
  #     # In practice, leave empty (deny-all) until the schema widens to
  #     # Vec<String>, or run Slack in a private workspace.
  #     whitelist: []
  #
  #     # session_timeout_hours: 24
  #     # max_concurrent_runs: 8
  platforms: {}

# --- Cron ---
cron:
  # Wrap cron job responses with metadata (default: true)
  # wrap_response: true

# --- Memory ---
memory:
  # Memory provider: "file" (default), "sqlite", "grafeo", "duckdb"
  # provider: "file"

  # Optional write-only mirror provider (receives on_memory_write events)
  # mirror_provider: null

  # Enable/disable entire memory subsystem (default: true)
  # memory_enabled: true

  # Enable/disable USER.md profile store (default: true)
  # user_profile_enabled: true

  # Periodic memory-review nudge interval, in user turns (default: 10).
  # After this many successful agent turns, a fire-and-forget background
  # nudge asks the model to decide what's worth persisting to MEMORY.md /
  # USER.md vs. leaving in session history (searchable via session_search).
  # The nudge runs in all three surfaces (CLI run_chat, Telegram gateway,
  # embedded web UI) and uses a private memory-only ToolRegistry — it cannot
  # call session_search, web_read, execute_code, or browser tools.
  #   nudge_interval: 10   # recommended starting point
  #   nudge_interval: 3    # aggressive (more memory writes, more API cost)
  #   nudge_interval: 0    # disable the periodic nudge entirely
  # nudge_interval: 10

  # Autonomous skill-creation guidance (Phase 33, LEARN-03/04).
  # When true AND the `skill_manage` tool is registered (via the `learning`
  # toolset), the system prompt includes the "Skill Creation (Learning Loop)"
  # trigger block telling the agent when to author a new SKILL.md. The
  # `skill_manage` tool writes self-created skills under
  # $HERMES_HOME/skills/<category>/<slug>/SKILL.md with trust_tier="Self-created".
  # Set to false to keep `skill_manage` available but suppress the prompt
  # block (e.g. for child agents or restricted deployments).
  # skill_creation_guidance: true

# --- Compression ---
compression:
  # Tokens to protect at end of conversation (default: 20000)
  # protect_last_tokens: 20000

  # Token budget for tool-pair boundary shifting (default: 500)
  # tool_pair_shift_tokens: 500

  # Number of messages protected at start of conversation (default: 3)
  # protect_first_n: 3

# --- Skills ---
skills:
  # Master enable switch (default: true)
  # enabled: true

  # Additional skill scan paths (appended after defaults)
  # extra_paths: []

  # Root directory for skill credentials
  # credential_dir: null

  # Per-skill configuration values
  # config:
  #   wiki:
  #     path: "~/research"
  #     format: "markdown"

  # Skills Hub settings
  # hub:
  #   trusted_repos: []
  #   github_token_env: null
  #   extra_taps: []
  #   well_known_origins: []

# --- Delegation (subagent spawning via delegate_task) ---
# Renamed from `subagent:` in Phase 32.2. See docs/DELEGATION.md for the full
# spec including per-call `role` / `max_iterations` schema and migration guide.
delegation:
  # Wall-clock timeout per child agent in seconds (default: 300)
  # child_timeout_seconds: 300

  # Stale-warn threshold; soft signal only. Hard kill ceiling is child_timeout_seconds.
  # Seconds of inactivity before a subagent is flagged [stale] in /agents output (default: 120).
  # Added in Phase 32.3 (D-05). Per-call override via the `stale_warn_seconds`
  # field in delegate_task JSON args. See docs/DELEGATION.md "Stale-Child Detection".
  # stale_warn_seconds: 120

  # Maximum concurrent children per batch (default: 3)
  # Oversize batches return a tool error rather than silently truncating
  # max_concurrent_children: 3

  # Maximum LLM iterations per child agent (default: 20)
  # Lowered from 50 to bound runaway-delegation cost (supersedes D-08).
  # Per-call `max_iterations` in the delegate_task tool args overrides this.
  # max_iterations: 20

  # Maximum spawn depth for `orchestrator`-role children (default: 1 = flat, no nesting)
  # 1 → only root agents can delegate (orchestrator children are downgraded to leaf)
  # 2 → one level of orchestrator children allowed
  # 3 → two levels (maximum supported value)
  # max_spawn_depth: 1

  # Global kill switch; when false all children downgrade to `leaf` regardless of per-call role (default: true)
  # orchestrator_enabled: true

  # Default toolset groups when none are specified per-call
  # default_toolsets: ["terminal", "file", "web"]

  # Override model for children (null = inherit parent's model)
  # model: null

  # Override provider for children (null = inherit parent's provider)
  # provider: null

  # Override API base URL for children (null = inherit parent's)
  # base_url: null

# --- Rate Limiting ---
rate_limit:
  # Maximum sustained messages per minute per user (default: 10)
  # messages_per_minute: 10

  # Maximum burst size (default: 3)
  # burst_size: 3

# --- Batch Processing ---
batch:
  # Default worker concurrency (default: 4)
  # workers: 4

  # Default max agent iterations per prompt (default: 20)
  # max_turns: 20

  # Default output directory relative to cwd (default: "batch_output")
  # output_dir: "batch_output"

# --- Security ---
security:
  # Redact secrets in logs and output (default: true)
  # redact_secrets: true

# --- Provider Overrides ---
# Per-provider configuration. This is the canonical place to wire API keys
# and override defaults. `api_key_env` references an env var name (validated
# against [A-Z][A-Z0-9_]*) — the actual secret stays in ~/.ironhermes/.env.
#
# Recommended pattern (silences the deprecation warnings for legacy env-var
# fallback and `model.api_key`):
#
# IMPORTANT: At least one provider entry with api_key_env matching model.provider
# is REQUIRED for validation to pass. Without it the setup wizard re-launches
# on every start. The actual secret stays in ~/.ironhermes/.env.
#
# Canonical pattern (cloud-primary, API-key-only — the default):
#
# A fallback provider is OPT-IN. Configure one only if it actually runs on
# this host; see the commented Ollama example further down.
#
#   - openrouter is the primary provider (matches model.provider above)
#   - api_key_env points to OPENROUTER_API_KEY in ~/.ironhermes/.env
#   - fallback_providers (OPT-IN, off by default): when openrouter returns
#     401/403/404/429/5xx the agent one-shots a swap to the named fallback
#     provider. The fallback uses ITS OWN `default_model` — the primary's model
#     string is NOT carried over. Only name a provider that actually runs here.
#   - if you enable the Ollama example below, give it an explicit base_url
#     (env-var interpolation in YAML is NOT supported; the URL must be a
#     literal). The dummy OLLAMA_API_KEY=ollama value in .env satisfies the
#     api_key_env contract.
#
# NOTE on extra_request_options (PROV-11..PROV-14):
#   `model.extra_request_options` is NOT a field — it must live under
#   `providers.<name>.extra_request_options`. Provider-level keys flow into
#   every request; `models.<model>.extra_request_options` overrides per-key
#   for that specific model (merge semantics).
#
providers:
  openrouter:
    api_key_env: OPENROUTER_API_KEY     # secret lives in .env
    # fallback_providers: ["ollama"]    # OPT-IN — see the commented ollama
                                        # block below. Leave this off unless
                                        # you actually run a fallback provider
                                        # on this host; a fallback pointing at
                                        # a port nothing listens on turns a
                                        # clean auth error into a confusing
                                        # connection-refused one.
    # api_mode: chat_completions          # override only if needed
    # base_url: null                      # override only if needed
    # default_model: "anthropic/claude-sonnet-5"
    # disabled: false                     # set true to exclude from resolver
    #
    # OpenRouter routing preference (upstream provider IDs — anthropic, openai,
    # mistral, etc. — NOT your local provider names):
    # extra_request_options:
    #   provider:
    #     order: ["anthropic", "openai"]
# --- Optional local/remote Ollama fallback (OPT-IN) -------------------------
# Uncomment BOTH this block AND the `fallback_providers` line above to enable.
# Only do so on a host that actually runs Ollama. Server/container deployments
# are API-key-only by default and should leave this off.
#
#   ollama:
#     api_key_env: OLLAMA_API_KEY                # add OLLAMA_API_KEY=ollama in .env
#     base_url: "http://localhost:11434/v1"      # local; for a remote host use http://<host>:11434/v1
#     api_mode: chat_completions
#     default_model: "llama3.1:8b"
#     # Provider-level extras — applied to every request to this provider
#     extra_request_options:
#       num_ctx: 8192            # default 8K context window
#       num_predict: 512
#     # Per-model overrides — merged per-key on top of provider-level defaults
#     models:
#       "llama3.1:8b":
#         extra_request_options:
#           num_ctx: 32768       # bump just this model to 32K
#       "qwen2.5-coder:7b":
#         extra_request_options:
#           top_k: 40
#   anthropic:
#     api_key_env: ANTHROPIC_API_KEY
#     api_mode: anthropic_messages
#
#   # --- OpenAI ---
#   # Required for the realtime open-mic voice path (voice.barge_in_mode: open_mic,
#   # Phase 36.17.12). The realtime token endpoint (issue_realtime_token) resolves
#   # the key env-var NAME from providers.openai.api_key_env, defaulting to
#   # OPENAI_API_KEY, then reads the secret from ~/.ironhermes/.env. Without a
#   # resolvable key, realtime is unavailable and voice gracefully falls back to
#   # the turn-based path (D-07). NOTE: this is a SEPARATE key resolution from STT
#   # (stt.openai), which prefers VOICE_TOOLS_OPENAI_KEY then OPENAI_API_KEY. To
#   # reuse a single OpenAI key for both, set api_key_env to the same var name you
#   # put in .env (e.g. OPENAI_API_KEY) and define it once there.
#   openai:
#     api_key_env: OPENAI_API_KEY     # secret (sk-...) lives in ~/.ironhermes/.env
#     api_mode: chat_completions
#
#   # --- vLLM (local) with top_k / top_p ---
#   vllm:
#     base_url: "http://localhost:8000/v1"
#     api_mode: chat_completions
#     extra_request_options:
#       top_k: 40
#       top_p: 0.95
#
# Legacy fields (still parsed, will warn at startup):
#   - `api_key: <literal>` under a provider — use `api_key_env` instead.
#   - `model.api_key:` at the top level — use `providers.<main>.api_key_env`.
#   - `model.api_key_env:` at the top level — NOT a field on ModelConfig; serde
#     silently drops it. Move to `providers.<main>.api_key_env`.
#   - Bare `OPENROUTER_API_KEY` / `ANTHROPIC_API_KEY` / `OPENAI_API_KEY` env
#     vars without a matching `providers.<name>.api_key_env` declaration.

# --- Custom Providers ---
# User-defined OpenAI-compatible endpoints. A common use is naming a local
# Ollama / llama.cpp server here and listing it under a primary's
# `fallback_providers` so the agent falls back to it on hard failure.
# When the fallback fires it uses the `default_model` defined HERE — not the
# primary's model — so this must name a model the local server has loaded.
# custom_providers:
#   - name: "local-llama"
#     base_url: "http://localhost:11434/v1"
#     api_key: "ollama"
#     api_mode: chat_completions
#     default_model: "llama3.2:latest"

# --- Learning Loop ---
# These keys are written by the setup wizard (`apply_learning_loop_answer` in
# `ironhermes-core/src/wizard.rs`) via a raw-YAML splice. They are NOT part of
# the typed `Config` struct (serde ignores them) and survive only through the
# raw-YAML load-mutate-save path. When the learning loop is disabled,
# `skill_generation_enabled` and `skill_eval` become `false`; the other three
# keys keep the same values shown below.
# learning:
#   skill_generation_enabled: true
#   periodic_nudge_interval_seconds: 300
#   reflection_depth: "standard"
#   skill_eval: true
#   max_skills: 500

# --- Tools ---
# Mirrors `ToolsConfig::default()` in `ironhermes-core/src/config.rs`.
# Each key under `toolsets:` is a toolset name; `enabled: false` keeps all
# of that toolset's tools out of the LLM tool list entirely.
# tools:
#   toolsets:
#     memory:
#       enabled: true
#     session:
#       enabled: true
#     agent:
#       enabled: true
#     skills:
#       enabled: true
#     robotics:
#       enabled: true   # gates further on HEXAPOD_IP env var
#     learning:
#       enabled: true   # Phase 33 — autonomous skill creation (skill_manage tool)
#     web:
#       enabled: false   # opt-in required
#     code:
#       enabled: false   # opt-in required
#     browser:
#       enabled: false   # opt-in required

# --- Hooks ---
# hooks:
#   jsonl_log: true
#   webhooks: []

# --- Tools ---
# Mirrors `ToolsConfig::default()` in `ironhermes-core/src/config.rs`.
# Each key under `toolsets:` is a toolset name; `enabled: false` keeps all
# of that toolset's tools out of the LLM tool list entirely.
tools:
  # toolsets:
  #   memory:
  #     enabled: true
  #   session:
  #     enabled: true
  #   agent:
  #     enabled: true
  #   skills:
  #     enabled: true
  #   messaging:
  #     enabled: true   # Phase 36.3.8 — send_message + clarify (default on;
  #                     # send is whitelist-gated). Set false to remove both
  #                     # tools from the LLM tool list across all surfaces.
  #   robotics:
  #     enabled: true   # gates further on HEXAPOD_IP env var
  #   learning:
  #     enabled: true   # Phase 33 — autonomous skill creation (skill_manage tool)
  #   web:
  #     enabled: false   # opt-in required
  #   code:
  #     enabled: false   # opt-in required
  #   browser:
  #     enabled: false   # opt-in required

  # --- Tool execution timeout (Phase 41.3 D-04/D-05/D-06/D-15) ---
  # Precedence, highest first: timeout_overrides[<tool>] > the tool's own
  # declared budget (code) > timeout_secs (below) > the 60s trait-default
  # constant. A configured value <= 0 DISABLES the bound for that tool — this
  # applies to both timeout_overrides entries and timeout_secs itself, and an
  # override wins even over a tool's own code-level opt-out (so a wedged
  # opted-out tool can still be capped from here, no rebuild needed). See
  # docs/CONFIGURATION.md for the full chain.
  # timeout_secs: 60
  # timeout_overrides:
  #   web_extract: 120   # example: give a slow multi-URL batch more room
  #   # some_tool: 0     # example: disable the bound for some_tool entirely

  # --- Web-tool provider chains (Phase 41.3 D-08) ---
  # Each tool tries its configured providers in order; an entry whose
  # credential is absent is skipped, a failing entry falls through to the
  # next, and an unknown provider name is a validation error `ironhermes doctor`
  # reports. Every chain below shows its shipped default order — uncomment
  # and reorder to change it, e.g. to promote a provider ahead of another or
  # demote a scraping-only fallback. Legal values are per-tool (see
  # docs/CONFIGURATION.md); DuckDuckGo ("ddg"/"local") always terminates each
  # chain so no key is ever required to use these tools.
  # web_search:
  #   chain: ["exa", "brave", "tavily", "ddg"]
  # web_answer:
  #   chain: ["perplexity", "exa", "brave", "ddg"]
  # web_extract:
  #   chain: ["firecrawl", "exa", "tavily", "local"]

  # --- Tool credentials — the CONFIG tier (Phase 41.3 D-18/D-19) ---
  # The middle tier of the env -> config -> vault credential precedence
  # chain, keyed by the CANONICAL env-var name (e.g. EXA_API_KEY — never a
  # `tools.`-prefixed variant). Consulted only when the matching process env
  # var is absent, and consulted before the vault. THIS STORES THE SECRET IN
  # PLAINTEXT ON DISK in this file — the process environment or the vault
  # (vault.enabled: true) is the preferred home for a real credential; this
  # map exists for operators who cannot use either. Ships empty. See
  # docs/CONFIGURATION.md for all three tiers and their precedence.
  # credentials: {}
  #   # EXA_API_KEY: "your-key-here"   # example only — do not commit a real key

# --- Auxiliary Model Routing ---
# Optional per-role model assignments. Absent = all helper tasks use the main provider.
auxiliary:
  # provider: ""        # provider name for auxiliary calls (empty = inherit from main)
  # model: ""           # model identifier (empty = inherit from main)
  # kanban_decomposer:  # decomposer role (Phase 36.3.7.10)
  #   provider: ""
  #   model: ""
  # kanban_judge:       # goal-mode judge role (Phase 36.3.7.12)
  #   provider: ""
  #   model: ""

# --- Custom Providers ---
# User-defined OpenAI-compatible endpoints. A common use is naming a local
# Ollama / llama.cpp server here and listing it under a primary's
# `fallback_providers` so the agent falls back to it on hard failure.
custom_providers: []
# custom_providers:
#   - name: "local-llama"
#     base_url: "http://localhost:11434/v1"
#     api_key: "ollama"
#     api_mode: chat_completions
#     default_model: "llama3.2:latest"

# --- MCP Servers ---
# MCP server configurations (Phase 21.2). Each key is a server name; value is
# a free-form map parsed by ironhermes-mcp at startup.
mcp_servers: {}
# mcp_servers:
#   my-mcp-server:
#     command: "npx"
#     args: ["-y", "@my-org/my-mcp-server"]
#     env:
#       MY_API_KEY_ENV: MY_API_KEY
#
#   # --- Cloudflare control-plane servers (Phase 46, CFL-02/D-04/D-05) ---
#   # Each server is its own OAuth resource (own PRM/DCR/PKCE); connect one at a
#   # time via `hermes mcp connect <name>`. No bulk-connect flow exists (D-05).
#   # The `docs` server (docs.mcp.cloudflare.com) is public/no-OAuth and is
#   # intentionally NOT wired here (Pitfall 5).
#   cloudflare_api:
#     # ROOT domain — this is Cloudflare's "Cloudflare API" server. It is NOT
#     # api.mcp.cloudflare.com, which does not resolve (RESEARCH Pitfall 4).
#     url: "https://mcp.cloudflare.com/mcp"
#     oauth_provider: "cloudflare_api"
#   cloudflare_bindings:
#     # Verified live 2026-06-30 (23 tools).
#     url: "https://bindings.mcp.cloudflare.com/mcp"
#     oauth_provider: "cloudflare_bindings"
#   cloudflare_observability:
#     url: "https://observability.mcp.cloudflare.com/mcp"
#     oauth_provider: "cloudflare_observability"
#   cloudflare_builds:
#     # Connect live-verified in Phase 46 UAT; upstream server self-describes
#     # as work-in-progress.
#     url: "https://builds.mcp.cloudflare.com/mcp"
#     oauth_provider: "cloudflare_builds"

# --- Autonomous Mode ---
# Controls yolo (auto-approve dangerous commands) behavior. D-11/D-12/D-14.
autonomous:
  # When true, skip dangerous-command approval prompts. Budget 100% /
  # fatal error / user interrupt remain unskippable (G-01/G-04/G-09).
  # yolo: false

# --- Browser Automation ---
# Phase 25.1 D-18: chromiumoxide browser configuration.
browser:
  # Launch browser in headed mode (visible window). Default: false (headless).
  # headed: false

  # Disable Chrome sandbox (required in some CI/Docker environments). Default: false.
  # no_sandbox: false

  # Allowed domains for browser navigation (SSRF protection). Empty = allow all.
  # allowed_domains: []

  # Allowed URL schemes. Default: ["http", "https"].
  # allowed_schemes: ["http", "https"]

  # Path to Chromium/Chrome binary (null = auto-detect). Default: null.
  # chromium_path: null

  # Navigation timeout in seconds. Default: 30.
  # timeout_seconds: 30

  # Persistent user data directory for cookies/localStorage (null = ephemeral per session).
  # user_data_dir: null

# --- Web Extract ---
# Phase 25.2 D-22: web content extraction and summarization configuration.
extract:
  # Maximum parallel summarization LLM calls. Default: 4.
  # max_parallel_summaries: 4

  # Character chunk size for summarization passes. Default: 100000.
  # summary_chunk_chars: 100000

  # Content length above which extraction is refused entirely. Default: 2000000.
  # refuse_threshold_chars: 2000000

  # Tier-2 summary threshold in chars (content > this triggers a second pass). Default: 5000.
  # summary_tier2_threshold_chars: 5000

  # Tier-3 summary threshold (very large content, extra compression). Default: 500000.
  # summary_tier3_threshold_chars: 500000

  # URL patterns to redact from extracted content (regex list). Default: [].
  # redact_url_patterns: []

  # Phase 41.3 D-16: per-URL deadline (seconds) inside a multi-URL
  # web_extract batch. A URL that exceeds this budget surfaces as an
  # in-array error entry at its own index instead of sinking the whole
  # batch — the direct fix for one bot-walled homepage hanging a 6-URL
  # call indefinitely. Default: 60.
  # per_url_timeout_secs: 60

# --- Image & Video Generation (Phase 47: multi-provider) ---
# The generation tools — image_gen (text->image), video_generate (t2v),
# video_animate (i2v), and the net-new video_to_video (v2v) — are provider- AND
# model-configurable PER MODE. Two backends ship: venice.ai (the default) and
# fal.ai. For a tool to appear to the LLM, BOTH must hold:
#   1. The RESOLVED backend's API key is set in ~/.ironhermes/.env:
#        venice modes -> VENICE_API_KEY   |   fal modes -> FAL_KEY
#      When the key for a mode's resolved backend is unset, that tool is hidden
#      and no client is built (zero startup cost). Keys are read lazily, never logged.
#   2. The surface is enabled: for chat, the `web` toolset must be on
#      (tools.toolsets.web.enabled: true) — the generation tools live in `web`.
#      For kanban/delegate, see generation.guardrails.surfaces below.
#
# Per-mode `provider`: "venice" | "fal" | null. null INFERS the backend from the
# model id prefix (fal-ai/* -> fal, else venice; D-02). The legacy flat keys
# (default_model / default_t2v_model / default_i2v_model) are kept for back-compat:
# set one AWAY from its shipped fal default and it maps into that mode's `model`
# with provider forced to prefix-inference; leave it at the fal default and the
# venice per-mode default below wins. The whole block is optional (serde defaults).
image_gen:
  # Legacy flat fal model id (back-compat). Default: "fal-ai/flux/schnell".
  # default_model: "fal-ai/flux/schnell"

  # Per-chat-session hard cap on DIRECT chat generations (abuse guard). At the
  # cap, image_gen returns a non-retried message and never calls the provider.
  # Config-only — NOT LLM-overridable. Default: 20. (Chat only; delegate/kanban
  # descendants use generation.guardrails instead — D-08.)
  # session_cap: 20

  # Provider poll timeout (seconds) for a single queue job. Default: 120.
  # timeout_secs: 120

  # Venice diffusion sampling-step count. REQUIRED for a finished image: Venice
  # does NOT apply the model's own constraints.steps.default when this is omitted,
  # so too low a value returns an under-denoised "blob". 20 is the flux-2-pro /
  # krea-2-turbo default; raise toward the model max (50) for more detail. `0`
  # omits the field (Venice server-side fallback). Ignored by fal models.
  # Config-only — NOT LLM-overridable. Default: 20.
  # steps: 20

  # Venice safe_mode: true blurs adult-flagged output; false disables the blur
  # (sensible for a single-user host). Venice-only (fal ignores it). Default: false.
  # safe_mode: false

  # Phase 47 per-mode {provider, model} for text-to-image. Default: venice / flux-2-pro.
  # t2i:
  #   provider: "venice"        # "venice" | "fal" | null(=infer from model prefix)
  #   model: "flux-2-pro"

# --- Video Generation (Phase 47) ---
# text-to-video (t2v), image-to-video (i2v), net-new video-to-video (v2v).
# Venice video is an async submit+poll job API.
video_gen:
  # Legacy flat fal model ids (back-compat). Defaults shown.
  # default_t2v_model: "fal-ai/ltx-2.3/text-to-video"
  # default_i2v_model: "fal-ai/ltx-2.3/image-to-video"

  # Per-session cap on DIRECT chat video generations (paid; lower than image).
  # Config-only — NOT LLM-overridable. Default: 5.
  # session_cap: 5

  # Provider poll timeout (seconds) — video is slower than image. Default: 300.
  # timeout_secs: 300

  # Maximum inline delivery size in bytes (Telegram sendVideo cap). Default: 52428800 (50 MiB).
  # max_inline_bytes: 52428800

  # Default clip duration in seconds. Default: 6.
  # default_duration_secs: 6

  # Phase 47 per-mode {provider, model}. Defaults: venice / wan-2-7-*.
  # t2v:
  #   provider: "venice"
  #   model: "wan-2-7-text-to-video"
  # i2v:
  #   provider: "venice"
  #   model: "wan-2-7-image-to-video"
  # v2v:                                  # net-new mode (no legacy flat key)
  #   provider: "venice"
  #   model: "wan-2-7-video-to-video"

  # Fixed-from-config resolution / aspect ratio (D-12). Defaults: "720p" / "16:9".
  # resolution: "720p"
  # aspect_ratio: "16:9"

  # Periodic "Still working on your video…" ping cadence (seconds) during the
  # async poll. 0 / absent = off (single-ack). Default: 30.
  # progress_ping_secs: 30

# --- Generation Guardrails (Phase 47 D-07/D-08) ---
# Cross-surface spend policy for the generation tools. IMPORTANT (D-08):
# session_pool + per_child_cap apply ONLY to delegate/kanban DESCENDANTS — NOT to
# direct chat, which stays governed by image_gen.session_cap / video_gen.session_cap
# above. A descendant generation decrements BOTH its per_child_cap allowance AND the
# shared session_pool. Cross-process safe: in-process delegate children share the
# parent's counter; kanban swarms account via kanban.db keyed by the root task id.
generation:
  guardrails:
    # Shared aggregate cap across ALL delegate/kanban descendants of a root.
    # 0 = block descendant generations immediately. Default: 20.
    # session_pool: 20

    # Per-child sub-cap so one descendant can't drain the whole pool. 0 = block. Default: 3.
    # per_child_cap: 3

    # Per-surface enable map — a false surface never registers its generation
    # tools (the wall is at registration time, not just call time).
    # surfaces:
    #   chat: true               # direct chat (never subject to per_child_cap)
    #   kanban: true             # regular kanban worker generation
    #   kanban_goal_mode: false  # kanban goal-mode workers (opt-in)
    #   delegate: false          # delegate_task children ("generation" group, opt-in)

# --- Prompt Caching ---
# Phase 36.2 D-CACHE-02: Anthropic cache_control breakpoint configuration.
prompt_caching:
  # Enable prompt caching for Anthropic models. Default: true.
  # enabled: true

  # Cache TTL for Anthropic cache_control markers. Valid values: "5m" or "1h".
  # Default: "1h" (long TTL for cross-session cached prefixes).
  # ttl: "1h"

# --- Kanban ---
# Phase 36.3.7 D-09: Kanban dispatcher configuration.
# Stored as raw YAML (kanban is serde_yaml::Value in Config to avoid circular deps).
# The gateway runner deserializes this into KanbanConfig at startup.
# All 17 KanbanConfig fields with defaults from KanbanConfig::default():
kanban:
  # Run dispatcher tokio task inside the gateway runtime. Default: true (D-09).
  # dispatch_in_gateway: true

  # Dispatcher tick period in seconds. Default: 60.
  # dispatch_interval_seconds: 60

  # Concurrency cap for running tasks (null = unlimited). Default: 8 (D-11).
  # max_in_progress: 8

  # Circuit-breaker consecutive-failure limit before auto-blocking a task. Default: 2 (D-12).
  # failure_limit: 2

  # Stranded-task diagnostic threshold in seconds. Default: 1800 (30 min, D-14).
  # stranded_threshold_seconds: 1800

  # Running-task stale timeout in seconds. Default: 14400 (4 h).
  # dispatch_stale_timeout_seconds: 14400

  # Board-level default workdir (null = no override; per-task workspace wins). Default: null (D-32).
  # default_workdir: null

  # RESERVED: Cross-profile gateway subscription source names (deferred notifier phase, D-37).
  # null = notifier disabled. Default: null.
  # notification_sources: null

  # Notifier poll tick in seconds (Phase 36.3.7.5). Default: 3.
  # notifier_poll_seconds: 3

  # Auto-decompose triage tasks each dispatcher tick (opt-in). Default: false.
  # auto_decompose: false

  # LLM decomposition cap per tick. Default: 3.
  # auto_decompose_per_tick: 3

  # Profile for decomposition; empty = active default. Default: "".
  # orchestrator_profile: ""

  # Fallback assignee; empty = active default. Default: "".
  # default_assignee: ""

  # Model for decomposer; empty = auxiliary.kanban_decomposer then main. Default: "".
  # decomposer_model: ""

  # Auto-promote decomposed children with no blockers to ready. Default: true.
  # auto_promote_children: true

  # Model for goal-mode judge; empty = auxiliary.kanban_judge then main. Default: "".
  # judge_model: ""

  # Inner-loop iteration cap for goal-mode workers (F-03). Default: 10.
  # goal_inner_max_iterations: 10

# --- Dashboard ---
# Phase 36.3.7.11 D-17: dashboard tail consumer configuration.
dashboard:
  # kanban:
  #   # Tail consumer polling interval in milliseconds. Default: 250 ms.
  #   tail_interval_ms: 250

# --- Voice (recording + silence detection + wake word) ---
# Voice-mode recording, voice-activity detection (VAD), and wake-word config.
# Consumed by the CLI/TUI voice loop and the web voice mode.
voice:
  # Key binding to start/stop recording in CLI/TUI voice mode. Default: "ctrl+b".
  # record_key: "ctrl+b"

  # RMS energy threshold below which audio counts as silence. Default: 200.
  # silence_threshold: 200

  # Seconds of continuous silence that ends a recording. Default: 3.0.
  # Lower this if end-of-speech detection feels too slow.
  # silence_duration: 3.0

  # Automatically speak agent responses via TTS after a voice turn.
  # NOTE: honored by the CLI/TUI today; web-UI auto-speak wiring is a follow-up.
  # Default: false.
  # auto_tts: false

  # Play an audio beep when recording starts/stops (CLI/TUI). Default: true.
  # beep_enabled: true

  # Maximum allowed recording length in seconds. Default: 120.
  # max_recording_seconds: 120

  # Barge-in behavior during agent TTS playback. Supported:
  #   "push_to_interrupt" — turn-based; user presses the record key to interrupt
  #                         (CLI/TUI + web). The default and only mode for CLI/TUI.
  #   "open_mic"          — Mode C full-duplex realtime voice over OpenAI Realtime
  #                         API + WebRTC (web/orb only, Phase 36.17.12). Requires an
  #                         OpenAI key resolvable via providers.openai.api_key_env
  #                         (default OPENAI_API_KEY in ~/.ironhermes/.env). When the
  #                         key/realtime is unavailable it gracefully degrades to the
  #                         turn-based path (D-07). CLI/TUI stays turn-based (D-11).
  #   "half_duplex"       — deferred (not wired).
  # Default: "push_to_interrupt".
  # barge_in_mode: "push_to_interrupt"

  # Wake-word activation (case-insensitive "contains" match). Default: disabled.
  # wake_word:
  #   enabled: false
  #   phrase: "hey hermes"

  # OpenAI Realtime API model for the open-mic WebRTC voice path
  # (voice.barge_in_mode: open_mic, Phase 36.17.12). The server resolves this
  # from config and validates against a whitelist before any network call.
  # Changing to an unlisted model triggers the D-07 graceful fallback to
  # turn-based voice. Current GA model (2026): "gpt-realtime".
  # Default: "gpt-realtime".
  # realtime_model: "gpt-realtime"

  # OpenAI Realtime agent voice (open-mic WebRTC path). Server-resolved and
  # whitelist-validated; an unlisted value triggers the D-07 fallback. One of:
  # alloy, shimmer, echo, verse, ash, ballad, coral, sage. Default: "shimmer".
  # realtime_voice: "shimmer"

  # Input-audio transcription model for the realtime path. When set, the provider
  # transcribes YOUR speech and the web UI shows it in the transcript card.
  # Server-resolved + whitelist-validated. One of "gpt-4o-mini-transcribe"
  # (default), "gpt-4o-transcribe", "whisper-1", or "off" to disable.
  # realtime_transcription_model: "gpt-4o-mini-transcribe"

  # Realtime input tuning (Phase 36.17.12 BUG 5 fix). These shape the GA
  # session.update (session.audio.input) the browser sends on connect, and are
  # the main levers against background-noise false triggers / misheard speech.
  #
  # noise_reduction filters mic audio BEFORE VAD + the model:
  #   "far_field"  — laptop / built-in / conference mic (default; most aggressive)
  #   "near_field" — headset / earbuds (close-talking)
  #   "off"        — disable (sent as null)
  # realtime_noise_reduction: "far_field"
  #
  # vad_mode — how end-of-turn is detected:
  #   "semantic_vad" — model-based; best at ignoring noise/humming/filler (default)
  #   "server_vad"   — energy-based; lowest latency; uses the values below
  # realtime_vad_mode: "semantic_vad"
  #
  # The following apply ONLY when vad_mode == "server_vad":
  #   threshold (0.0–1.0; higher = less sensitive), and turn timing in ms.
  # realtime_vad_threshold: 0.5
  # realtime_vad_silence_ms: 500
  # realtime_vad_prefix_ms: 300

  # Web Audio (browser) RMS silence threshold. DISTINCT from silence_threshold
  # (native PCM scale). Web VAD path only. Default: 5.0. Lower if the browser never
  # detects end-of-speech; raise if it cuts off too early.
  # web_silence_threshold_rms: 5.0

# --- STT (Speech-to-Text) ---
# STT provider configuration used to transcribe microphone audio (web voice
# mode + CLI). Requires a provider API key in ~/.ironhermes/.env:
#   - groq   → GROQ_API_KEY
#   - openai → VOICE_TOOLS_OPENAI_KEY (preferred) or OPENAI_API_KEY
stt:
  # Active STT provider. Supported: "auto", "groq", "openai". Default: "auto".
  # "auto" selects the first provider whose API key is present at runtime.
  # provider: "auto"

  # Groq STT settings
  # groq:
  #   # Groq Whisper model. Default: "whisper-large-v3-turbo".
  #   model: "whisper-large-v3-turbo"

  # OpenAI STT settings
  # openai:
  #   # OpenAI Whisper model. Default: "whisper-1".
  #   model: "whisper-1"

# --- TTS (Text-to-Speech) ---
# Phase 36.17.5 D-12: TTS provider configuration.
tts:
  # Active TTS provider. Supported: "edge" (Microsoft Edge TTS — keyless),
  # "elevenlabs" (requires ELEVENLABS_API_KEY), "openai" (requires OPENAI_API_KEY).
  # Default: "edge". This is the GLOBAL fallback; per-avatar overrides under
  # `identities:` win over it (Phase 40.5). See docs/VOICE-TO-VOICE.md.
  # provider: "edge"

  # Optional path to ffmpeg binary for MP3→Opus conversion. null = auto-detect. Default: null.
  # ffmpeg_path: null

  # Edge TTS provider settings
  # edge:
  #   # Edge TTS voice name. Default: "en-US-AriaNeural".
  #   voice: "en-US-AriaNeural"
  #   # Audio output format. Default: "mp3".
  #   output_format: "mp3"

  # ElevenLabs provider settings (requires ELEVENLABS_API_KEY in .env)
  # elevenlabs:
  #   # ElevenLabs voice ID. Default: "pNInz6obpgDQGcFmaJgB" (Adam voice).
  #   voice_id: "pNInz6obpgDQGcFmaJgB"
  #   # ElevenLabs model ID. Default: "eleven_multilingual_v2".
  #   model_id: "eleven_multilingual_v2"
  #   # Audio output format. Default: "mp3".
  #   output_format: "mp3"

  # OpenAI TTS provider settings (Phase 40.5; requires OPENAI_API_KEY in .env).
  # openai:
  #   # OpenAI TTS model. Default: "tts-1".
  #   model: "tts-1"
  #   # OpenAI TTS voice. Default: "alloy". One of: alloy, echo, fable, onyx, nova, shimmer.
  #   voice: "alloy"
  #   # Audio output format. Default: "mp3".
  #   format: "mp3"

# --- Identities (Phase 40.5: per-avatar voice + orb appearance) ---
# Each orb/avatar identity can carry its OWN free-mode TTS voice/provider and its
# OWN realtime voice, overriding the global `tts:` / `voice:` settings above. The
# LLM and STT stay global (D-08 scope fence — an identity is a voice, not a separate
# agent). Records live here in config.yaml; the *active* identity pointer lives in
# the browser (AvatarPrefs.active_identity in localStorage) and is selected via the
# orb/avatar picker + the Voice Settings "Applies to" selector.
#
# Resolution (Config::effective_tts_config_for_identity): the active identity's
# non-null fields override the global config; null/absent fields inherit it.
#   free_mode_tts_voice flows into the matching provider's voice slot:
#     elevenlabs -> elevenlabs.voice_id | openai -> openai.voice | edge -> edge.voice
# IMPORTANT: ElevenLabs voices are only heard in FREE mode (voice.barge_in_mode:
# push_to_interrupt). In open_mic/realtime, only OpenAI `realtime_voice` is used.
# Full guide: docs/VOICE-TO-VOICE.md
#
# This section is SEEDED automatically on first run (default_seed_identities) and
# missing shipped personas are back-filled, so you normally don't hand-write it.
# Shown here for reference / customization:
# identities:
#   orb_bloom:
#     display_name: "Bloom"
#     appearance:                 # orb visual knobs (null for head avatars)
#       style: "bloom"            # classic | bloom | ascii | network
#       base_hue: 280             # 0-360; listening/thinking/speaking shift relative to it
#       size: 1.0                 # 0.5-2.0 scale
#       glow: 0.8                 # 0.0-1.0 intensity
#     voice:
#       free_mode_tts_provider: "elevenlabs"   # edge | openai | elevenlabs | null(=inherit)
#       free_mode_tts_voice: "pNInz6obpgDQGcFmaJgB"  # Adam; for elevenlabs this is a voice_id
#       realtime_voice: "shimmer"              # OpenAI realtime voice (open_mic only)
#   orb_classic:
#     display_name: "Classic"
#     appearance: { style: "classic", base_hue: 186, size: 1.0, glow: 0.5 }
#     voice:                      # all-null -> inherits the global tts:/voice: config
#       free_mode_tts_provider: null
#       free_mode_tts_voice: null
#       realtime_voice: null

# --- Concurrency (Phase 39.1 async multi-turn) ---
# Per-session and process-wide caps for concurrent in-flight agent turns.
# Pre-39.1 configs parse cleanly via #[serde(default)].
concurrency:
  # Maximum concurrent in-flight turns per session (default: 3). Overflow queues FIFO.
  # session_turn_cap: 3
  # Process-wide maximum across all sessions and surfaces (default: 32).
  # global_turn_ceiling: 32

# --- Audio Cache ---
# Phase 36.17.7 D-02-d: audio cache lifecycle policy for ~/.ironhermes/audio_cache/.
audio_cache:
  # Maximum age in days for cached audio files. Default: 7.
  # max_age_days: 7

  # Periodic GC sweep interval in seconds. Default: 86400 (daily).
  # sweep_interval_secs: 86400

# --- Auth (Phase 43 — OAuth token acquisition) ---
# Provider OAuth flows. Each key under auth.providers is the namespace used in auth.json
# tokens.<name> and is the --provider argument to `hermes auth login`.
# All flow fields (authorization_url, token_url, client_id, scopes) are required for the
# relevant flow. device_authorization_url is required only for device-code flow.
# display_name is optional (the key is used if absent).
# No endpoint table ships in code — endpoints come only from operator config (D-02).
# auth:
#   providers:
#     xai:
#       display_name: "xAI Grok"
#       authorization_url: "https://accounts.x.ai/oauth/authorize"
#       token_url: "https://accounts.x.ai/oauth/token"
#       device_authorization_url: "https://accounts.x.ai/oauth/device/code"
#       client_id: "<your-registered-client-id>"
#       scopes: ["read", "write"]
#     minimax:
#       display_name: "MiniMax"
#       authorization_url: "https://api.minimax.chat/oauth/authorize"
#       token_url: "https://api.minimax.chat/oauth/token"
#       device_authorization_url: "https://api.minimax.chat/oauth/device/code"
#       client_id: "<your-registered-client-id>"
#       scopes: ["default"]

# --- Display (HermesApp footer clocks) ---
# Controls the web UI footer wall-clock(s). All fields are optional and the whole
# `display:` block can be omitted — pre-existing config.yaml files parse unchanged
# via serde defaults.
# display:
#   # Primary IANA zone name for the footer clock (e.g. "America/New_York").
#   # Resolution order when null: falls back to agent.timezone, then to the
#   # browser's host-local zone (Phase 46.9 Plan 11, GAP-4). Default: null.
#   timezone: null
#
#   # Additional IANA zones rendered as labeled clocks alongside the primary.
#   # Server-side capped at 4 (MAX_EXTRA_TIMEZONES) — an oversized list is
#   # truncated, not rejected (T-46.9-27 DoS mitigation). Default: [].
#   extra_timezones: []
#   # extra_timezones: ["America/Los_Angeles", "America/Denver", "Etc/GMT"]
#
#   # Footer clock time format (quick task 260718-qdg).
#   #   null / omitted -> 24-hour (default, e.g. 15:30:00) — unchanged behavior
#   #   true           -> 12-hour with AM/PM (e.g. 03:30:00 PM)
#   #   false          -> explicit 24-hour
#   # The None -> 24h default is resolved once server-side; the footer never
#   # re-derives it. Default: null.
#   hour12: null
