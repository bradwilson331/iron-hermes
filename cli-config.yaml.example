# =============================================================================
# IronHermes Configuration
# =============================================================================
# Copy to ~/.ironhermes/config.yaml and customize.
# Values shown are defaults -- uncomment and change as needed.
# Environment variables in .env override matching config values.

# --- Model Configuration ---
model:
  # Default model identifier
  # default: "anthropic/claude-sonnet-4"

  # LLM provider: openrouter, anthropic, openai, ollama, google, together, mistral, groq, deepseek, fireworks
  # provider: "openrouter"

  # Override API base URL (usually not needed)
  # base_url: null

  # DEPRECATED — use providers.<name>.api_key_env instead (see "Provider Overrides" below).
  # Kept one release for backwards compat; emits a deprecation banner at startup.
  # api_key: null

  # Vision model for image analysis (null = use default model)
  # vision_model: null

  # Maximum tokens per response (null = provider default)
  # max_tokens: null

  # Model context window size (null = auto-detect from model metadata)
  # context_length: null

  # Auxiliary model role assignments (provider + optional model override)
  # roles:
  #   vision:
  #     provider: "openrouter"
  #     model: "openai/gpt-4o"
  #   compression:
  #     provider: "main"    # "main" inherits the primary provider

# --- Agent Configuration ---
agent:
  # Maximum agent loop iterations per turn (default: 50)
  # Lowered from 90 to bound runaway-delegation cost — pairs with the
  # AgentLoop's consecutive-failure circuit breaker. Raise deliberately
  # if you need longer multi-step reasoning chains.
  # max_turns: 50

  # Context compression ratio (default: 0.5)
  # context_compression: 0.5

  # Delay between tool calls in seconds (default: 1.0)
  # tool_delay_secs: 1.0

  # Context engine: "summarizing" (default, uses LLM) or "local_prune" (heuristic)
  # context_engine: "summarizing"

  # Compression threshold as fraction of context_length (default: 0.5)
  # compression_threshold: 0.5

  # Optional system message injected into prompt (empty = omitted)
  # system_message: ""

  # Custom personality presets (name -> system prompt text)
  # personalities:
  #   pirate: "You are a helpful pirate assistant. Arr!"

# --- Terminal / Sandbox ---
terminal:
  # Sandbox backend: "local" (default) or "docker" (future)
  # backend: "local"

  # Default working directory for agent tool operations
  # "." means current directory; set to "~/.ironhermes/workspace" for isolation
  # cwd: "."

  # Command execution timeout in seconds (default: 30)
  # timeout: 30

# --- Web Tools ---
web:
  # Web scraping backend: "firecrawl" (default) or "raw"
  # backend: "firecrawl"

  # User-Agent header for HTTP requests
  # user_agent: "IronHermes/1.0 (+bot)"

  # Maximum content length in characters before truncation (default: 50000)
  # max_content_chars: 50000

  # HTTP request timeout in seconds (default: 30)
  # timeout_secs: 30

# --- Code Execution ---
exec:
  # Path to Python interpreter (default: "python3")
  # python_path: "python3"

  # Execution timeout in seconds (default: 300 = 5 minutes)
  # timeout_secs: 300

  # Maximum RPC calls per execution (default: 50)
  # max_rpc_calls: 50

  # Maximum stdout bytes before truncation (default: 50000)
  # max_output_bytes: 50000

  # Maximum stderr bytes before truncation (default: 10240)
  # max_stderr_bytes: 10240

# --- Gateway ---
gateway:
  # Context engine for gateway sessions (default: "local_prune")
  # context_engine: "local_prune"

  # Compression threshold for gateway (default: 0.85)
  # compression_threshold: 0.85

  # Platform adapters
  # The `platforms:` map is empty by default. Each platform key (telegram,
  # discord, slack) is independent — missing config sections SILENTLY SKIP at
  # gateway startup, so existing Telegram-only deployments don't change. For
  # any platform, both the config section AND a resolved token must be present
  # for the listener to spawn. See docs/MULTI-PLATFORM-GATEWAY.md for the full
  # operator guide (token acquisition, intents, Socket Mode setup).
  # platforms:
  #   telegram:
  #     # Enable Telegram gateway (informational; resolved token is the gate)
  #     enabled: true
  #
  #     # Bot token. Prefer the TELEGRAM_BOT_TOKEN env var (in ~/.ironhermes/.env)
  #     # over inlining the secret here. If both are set, env var wins.
  #     # token: "123456:ABC-DEF..."
  #
  #     # Allowed Telegram chat IDs (Vec<i64>). Empty list = deny all.
  #     # Get your chat ID by messaging @userinfobot on Telegram.
  #     whitelist: [123456789]
  #
  #     # Session inactivity timeout in hours (default: 24)
  #     # session_timeout_hours: 24
  #
  #     # Maximum concurrent agent runs (default: 8)
  #     # max_concurrent_runs: 8
  #
  #   # --- Discord (Phase 34, serenity 0.12.5) ---
  #   # Requires MESSAGE_CONTENT privileged gateway intent toggled on in the
  #   # Discord developer portal. Token resolves from inline value OR
  #   # DISCORD_BOT_TOKEN env var (Discord-specific; never picks up
  #   # TELEGRAM_BOT_TOKEN).
  #   discord:
  #     enabled: true
  #     # token: "YOUR.DISCORD.BOT.TOKEN"
  #
  #     # Allowed Discord user IDs (Vec<i64> snowflakes). Empty = deny all.
  #     # Enable Developer Mode in Discord settings, right-click a user →
  #     # "Copy User ID" to find your own snowflake.
  #     whitelist: [987654321]
  #
  #     # session_timeout_hours: 24
  #     # max_concurrent_runs: 8
  #
  #   # --- Slack (Phase 34, slack-morphism 2.22.0 Socket Mode) ---
  #   # Requires BOTH a bot token (xoxb-...) and an app-level token (xapp-...
  #   # with `connections:write` scope). The Slack listener silently skips
  #   # unless both resolve (Pitfall 2). Tokens fall back to SLACK_BOT_TOKEN
  #   # and SLACK_APP_TOKEN env vars respectively.
  #   slack:
  #     enabled: true
  #     # token: "xoxb-..."        # Bot User OAuth Token
  #     # app_token: "xapp-..."    # App-Level Token, connections:write scope
  #
  #     # NOTE: Slack channel IDs are alphanumeric (C..., D..., U...) but
  #     # this whitelist is Vec<i64> for now — see the caveat in
  #     # docs/MULTI-PLATFORM-GATEWAY.md "Slack whitelist caveat".
  #     # In practice, leave empty (deny-all) until the schema widens to
  #     # Vec<String>, or run Slack in a private workspace.
  #     whitelist: []
  #
  #     # session_timeout_hours: 24
  #     # max_concurrent_runs: 8
  platforms: {}

# --- Cron ---
cron:
  # Wrap cron job responses with metadata (default: true)
  # wrap_response: true

# --- Memory ---
memory:
  # Memory provider: "file" (default), "sqlite", "grafeo", "duckdb"
  # provider: "file"

  # Optional write-only mirror provider (receives on_memory_write events)
  # mirror_provider: null

  # Enable/disable entire memory subsystem (default: true)
  # memory_enabled: true

  # Enable/disable USER.md profile store (default: true)
  # user_profile_enabled: true

  # Periodic memory-review nudge interval, in user turns (default: 10).
  # After this many successful agent turns, a fire-and-forget background
  # nudge asks the model to decide what's worth persisting to MEMORY.md /
  # USER.md vs. leaving in session history (searchable via session_search).
  # The nudge runs in all three surfaces (CLI run_chat, Telegram gateway,
  # embedded web UI) and uses a private memory-only ToolRegistry — it cannot
  # call session_search, web_read, execute_code, or browser tools.
  #   nudge_interval: 10   # recommended starting point
  #   nudge_interval: 3    # aggressive (more memory writes, more API cost)
  #   nudge_interval: 0    # disable the periodic nudge entirely
  # nudge_interval: 10

  # Autonomous skill-creation guidance (Phase 33, LEARN-03/04).
  # When true AND the `skill_manage` tool is registered (via the `learning`
  # toolset), the system prompt includes the "Skill Creation (Learning Loop)"
  # trigger block telling the agent when to author a new SKILL.md. The
  # `skill_manage` tool writes self-created skills under
  # $HERMES_HOME/skills/<category>/<slug>/SKILL.md with trust_tier="Self-created".
  # Set to false to keep `skill_manage` available but suppress the prompt
  # block (e.g. for child agents or restricted deployments).
  # skill_creation_guidance: true

# --- Compression ---
compression:
  # Tokens to protect at end of conversation (default: 20000)
  # protect_last_tokens: 20000

  # Token budget for tool-pair boundary shifting (default: 500)
  # tool_pair_shift_tokens: 500

  # Number of messages protected at start of conversation (default: 3)
  # protect_first_n: 3

# --- Skills ---
skills:
  # Master enable switch (default: true)
  # enabled: true

  # Additional skill scan paths (appended after defaults)
  # extra_paths: []

  # Root directory for skill credentials
  # credential_dir: null

  # Per-skill configuration values
  # config:
  #   wiki:
  #     path: "~/research"
  #     format: "markdown"

  # Skills Hub settings
  # hub:
  #   trusted_repos: []
  #   github_token_env: null
  #   extra_taps: []
  #   well_known_origins: []

# --- Delegation (subagent spawning via delegate_task) ---
# Renamed from `subagent:` in Phase 32.2. See docs/DELEGATION.md for the full
# spec including per-call `role` / `max_iterations` schema and migration guide.
delegation:
  # Wall-clock timeout per child agent in seconds (default: 300)
  # child_timeout_seconds: 300

  # Stale-warn threshold; soft signal only. Hard kill ceiling is child_timeout_seconds.
  # Seconds of inactivity before a subagent is flagged [stale] in /agents output (default: 120).
  # Added in Phase 32.3 (D-05). Per-call override via the `stale_warn_seconds`
  # field in delegate_task JSON args. See docs/DELEGATION.md "Stale-Child Detection".
  # stale_warn_seconds: 120

  # Maximum concurrent children per batch (default: 3)
  # Oversize batches return a tool error rather than silently truncating
  # max_concurrent_children: 3

  # Maximum LLM iterations per child agent (default: 20)
  # Lowered from 50 to bound runaway-delegation cost (supersedes D-08).
  # Per-call `max_iterations` in the delegate_task tool args overrides this.
  # max_iterations: 20

  # Maximum spawn depth for `orchestrator`-role children (default: 1 = flat, no nesting)
  # 1 → only root agents can delegate (orchestrator children are downgraded to leaf)
  # 2 → one level of orchestrator children allowed
  # 3 → two levels (maximum supported value)
  # max_spawn_depth: 1

  # Global kill switch; when false all children downgrade to `leaf` regardless of per-call role (default: true)
  # orchestrator_enabled: true

  # Default toolset groups when none are specified per-call
  # default_toolsets: ["terminal", "file", "web"]

  # Override model for children (null = inherit parent's model)
  # model: null

  # Override provider for children (null = inherit parent's provider)
  # provider: null

  # Override API base URL for children (null = inherit parent's)
  # base_url: null

# --- Rate Limiting ---
rate_limit:
  # Maximum sustained messages per minute per user (default: 10)
  # messages_per_minute: 10

  # Maximum burst size (default: 3)
  # burst_size: 3

# --- Batch Processing ---
batch:
  # Default worker concurrency (default: 4)
  # workers: 4

  # Default max agent iterations per prompt (default: 20)
  # max_turns: 20

  # Default output directory relative to cwd (default: "batch_output")
  # output_dir: "batch_output"

# --- Security ---
security:
  # Redact secrets in logs and output (default: true)
  # redact_secrets: true

# --- Provider Overrides ---
# Per-provider configuration. This is the canonical place to wire API keys
# and override defaults. `api_key_env` references an env var name (validated
# against [A-Z][A-Z0-9_]*) — the actual secret stays in ~/.ironhermes/.env.
#
# Recommended pattern (silences the deprecation warnings for legacy env-var
# fallback and `model.api_key`):
#
# IMPORTANT: At least one provider entry with api_key_env matching model.provider
# is REQUIRED for validation to pass. Without it the setup wizard re-launches
# on every start. The actual secret stays in ~/.ironhermes/.env.
#
# Canonical pattern (cloud-primary + Ollama fallback, with remote Ollama host):
#
#   - openrouter is the primary provider (matches model.provider above)
#   - api_key_env points to OPENROUTER_API_KEY in ~/.ironhermes/.env
#   - fallback_providers: when openrouter returns 401/403/404/429/5xx the agent
#     one-shots a swap to the named fallback provider. The fallback uses ITS OWN
#     `default_model` — the primary's model string is NOT carried over.
#   - ollama is wired with an explicit remote base_url (env-var interpolation
#     in YAML is NOT supported; the URL must be a literal). The dummy
#     OLLAMA_API_KEY=ollama value in .env satisfies the api_key_env contract.
#
# NOTE on extra_request_options (PROV-11..PROV-14):
#   `model.extra_request_options` is NOT a field — it must live under
#   `providers.<name>.extra_request_options`. Provider-level keys flow into
#   every request; `models.<model>.extra_request_options` overrides per-key
#   for that specific model (merge semantics).
#
providers:
  openrouter:
    api_key_env: OPENROUTER_API_KEY     # secret lives in .env
    fallback_providers: ["ollama"]      # one-shot swap on hard failure
    # api_mode: chat_completions          # override only if needed
    # base_url: null                      # override only if needed
    # default_model: "anthropic/claude-sonnet-4"
    # disabled: false                     # set true to exclude from resolver
    #
    # OpenRouter routing preference (upstream provider IDs — anthropic, openai,
    # mistral, etc. — NOT your local provider names):
    # extra_request_options:
    #   provider:
    #     order: ["anthropic", "openai"]
  ollama:
    api_key_env: OLLAMA_API_KEY                  # add OLLAMA_API_KEY=ollama in .env
    base_url: "http://192.168.7.201:11434/v1"    # remote host example; use localhost for local
    api_mode: chat_completions
    default_model: "llama3.1:8b"
    # Provider-level extras — applied to every request to this provider
    extra_request_options:
      num_ctx: 8192            # default 8K context window
      num_predict: 512
    # Per-model overrides — merged per-key on top of provider-level defaults
    models:
      "llama3.1:8b":
        extra_request_options:
          num_ctx: 32768       # bump just this model to 32K
      "qwen2.5-coder:7b":
        extra_request_options:
          top_k: 40
#   anthropic:
#     api_key_env: ANTHROPIC_API_KEY
#     api_mode: anthropic_messages
#   openai:
#     api_key_env: OPENAI_API_KEY
#     api_mode: chat_completions
#
#   # --- vLLM (local) with top_k / top_p ---
#   vllm:
#     base_url: "http://localhost:8000/v1"
#     api_mode: chat_completions
#     extra_request_options:
#       top_k: 40
#       top_p: 0.95
#
# Legacy fields (still parsed, will warn at startup):
#   - `api_key: <literal>` under a provider — use `api_key_env` instead.
#   - `model.api_key:` at the top level — use `providers.<main>.api_key_env`.
#   - `model.api_key_env:` at the top level — NOT a field on ModelConfig; serde
#     silently drops it. Move to `providers.<main>.api_key_env`.
#   - Bare `OPENROUTER_API_KEY` / `ANTHROPIC_API_KEY` / `OPENAI_API_KEY` env
#     vars without a matching `providers.<name>.api_key_env` declaration.

# --- Custom Providers ---
# User-defined OpenAI-compatible endpoints. A common use is naming a local
# Ollama / llama.cpp server here and listing it under a primary's
# `fallback_providers` so the agent falls back to it on hard failure.
# When the fallback fires it uses the `default_model` defined HERE — not the
# primary's model — so this must name a model the local server has loaded.
# custom_providers:
#   - name: "local-llama"
#     base_url: "http://localhost:11434/v1"
#     api_key: "ollama"
#     api_mode: chat_completions
#     default_model: "llama3.2:latest"

# --- Learning Loop ---
# These keys are written by the setup wizard (`apply_learning_loop_answer` in
# `ironhermes-core/src/wizard.rs`) via a raw-YAML splice. They are NOT part of
# the typed `Config` struct (serde ignores them) and survive only through the
# raw-YAML load-mutate-save path. When the learning loop is disabled,
# `skill_generation_enabled` and `skill_eval` become `false`; the other three
# keys keep the same values shown below.
# learning:
#   skill_generation_enabled: true
#   periodic_nudge_interval_seconds: 300
#   reflection_depth: "standard"
#   skill_eval: true
#   max_skills: 500

# --- Tools ---
# Mirrors `ToolsConfig::default()` in `ironhermes-core/src/config.rs`.
# Each key under `toolsets:` is a toolset name; `enabled: false` keeps all
# of that toolset's tools out of the LLM tool list entirely.
# tools:
#   toolsets:
#     memory:
#       enabled: true
#     session:
#       enabled: true
#     agent:
#       enabled: true
#     skills:
#       enabled: true
#     robotics:
#       enabled: true   # gates further on HEXAPOD_IP env var
#     learning:
#       enabled: true   # Phase 33 — autonomous skill creation (skill_manage tool)
#     web:
#       enabled: false   # opt-in required
#     code:
#       enabled: false   # opt-in required
#     browser:
#       enabled: false   # opt-in required

# --- Hooks ---
# hooks:
#   jsonl_log: true
#   webhooks: []

# --- Tools ---
# Mirrors `ToolsConfig::default()` in `ironhermes-core/src/config.rs`.
# Each key under `toolsets:` is a toolset name; `enabled: false` keeps all
# of that toolset's tools out of the LLM tool list entirely.
tools:
  # toolsets:
  #   memory:
  #     enabled: true
  #   session:
  #     enabled: true
  #   agent:
  #     enabled: true
  #   skills:
  #     enabled: true
  #   robotics:
  #     enabled: true   # gates further on HEXAPOD_IP env var
  #   learning:
  #     enabled: true   # Phase 33 — autonomous skill creation (skill_manage tool)
  #   web:
  #     enabled: false   # opt-in required
  #   code:
  #     enabled: false   # opt-in required
  #   browser:
  #     enabled: false   # opt-in required

# --- Auxiliary Model Routing ---
# Optional per-role model assignments. Absent = all helper tasks use the main provider.
auxiliary:
  # provider: ""        # provider name for auxiliary calls (empty = inherit from main)
  # model: ""           # model identifier (empty = inherit from main)
  # kanban_decomposer:  # decomposer role (Phase 36.3.7.10)
  #   provider: ""
  #   model: ""
  # kanban_judge:       # goal-mode judge role (Phase 36.3.7.12)
  #   provider: ""
  #   model: ""

# --- Custom Providers ---
# User-defined OpenAI-compatible endpoints. A common use is naming a local
# Ollama / llama.cpp server here and listing it under a primary's
# `fallback_providers` so the agent falls back to it on hard failure.
custom_providers: []
# custom_providers:
#   - name: "local-llama"
#     base_url: "http://localhost:11434/v1"
#     api_key: "ollama"
#     api_mode: chat_completions
#     default_model: "llama3.2:latest"

# --- MCP Servers ---
# MCP server configurations (Phase 21.2). Each key is a server name; value is
# a free-form map parsed by ironhermes-mcp at startup.
mcp_servers: {}
# mcp_servers:
#   my-mcp-server:
#     command: "npx"
#     args: ["-y", "@my-org/my-mcp-server"]
#     env:
#       MY_API_KEY_ENV: MY_API_KEY

# --- Autonomous Mode ---
# Controls yolo (auto-approve dangerous commands) behavior. D-11/D-12/D-14.
autonomous:
  # When true, skip dangerous-command approval prompts. Budget 100% /
  # fatal error / user interrupt remain unskippable (G-01/G-04/G-09).
  # yolo: false

# --- Browser Automation ---
# Phase 25.1 D-18: chromiumoxide browser configuration.
browser:
  # Launch browser in headed mode (visible window). Default: false (headless).
  # headed: false

  # Disable Chrome sandbox (required in some CI/Docker environments). Default: false.
  # no_sandbox: false

  # Allowed domains for browser navigation (SSRF protection). Empty = allow all.
  # allowed_domains: []

  # Allowed URL schemes. Default: ["http", "https"].
  # allowed_schemes: ["http", "https"]

  # Path to Chromium/Chrome binary (null = auto-detect). Default: null.
  # chromium_path: null

  # Navigation timeout in seconds. Default: 30.
  # timeout_seconds: 30

  # Persistent user data directory for cookies/localStorage (null = ephemeral per session).
  # user_data_dir: null

# --- Web Extract ---
# Phase 25.2 D-22: web content extraction and summarization configuration.
extract:
  # Maximum parallel summarization LLM calls. Default: 4.
  # max_parallel_summaries: 4

  # Character chunk size for summarization passes. Default: 100000.
  # summary_chunk_chars: 100000

  # Content length above which extraction is refused entirely. Default: 2000000.
  # refuse_threshold_chars: 2000000

  # Tier-2 summary threshold in chars (content > this triggers a second pass). Default: 5000.
  # summary_tier2_threshold_chars: 5000

  # Tier-3 summary threshold (very large content, extra compression). Default: 500000.
  # summary_tier3_threshold_chars: 500000

  # URL patterns to redact from extracted content (regex list). Default: [].
  # redact_url_patterns: []

# --- Prompt Caching ---
# Phase 36.2 D-CACHE-02: Anthropic cache_control breakpoint configuration.
prompt_caching:
  # Enable prompt caching for Anthropic models. Default: true.
  # enabled: true

  # Cache TTL for Anthropic cache_control markers. Valid values: "5m" or "1h".
  # Default: "1h" (long TTL for cross-session cached prefixes).
  # ttl: "1h"

# --- Kanban ---
# Phase 36.3.7 D-09: Kanban dispatcher configuration.
# Stored as raw YAML (kanban is serde_yaml::Value in Config to avoid circular deps).
# The gateway runner deserializes this into KanbanConfig at startup.
# All 17 KanbanConfig fields with defaults from KanbanConfig::default():
kanban:
  # Run dispatcher tokio task inside the gateway runtime. Default: true (D-09).
  # dispatch_in_gateway: true

  # Dispatcher tick period in seconds. Default: 60.
  # dispatch_interval_seconds: 60

  # Concurrency cap for running tasks (null = unlimited). Default: 8 (D-11).
  # max_in_progress: 8

  # Circuit-breaker consecutive-failure limit before auto-blocking a task. Default: 2 (D-12).
  # failure_limit: 2

  # Stranded-task diagnostic threshold in seconds. Default: 1800 (30 min, D-14).
  # stranded_threshold_seconds: 1800

  # Running-task stale timeout in seconds. Default: 14400 (4 h).
  # dispatch_stale_timeout_seconds: 14400

  # Board-level default workdir (null = no override; per-task workspace wins). Default: null (D-32).
  # default_workdir: null

  # RESERVED: Cross-profile gateway subscription source names (deferred notifier phase, D-37).
  # null = notifier disabled. Default: null.
  # notification_sources: null

  # Notifier poll tick in seconds (Phase 36.3.7.5). Default: 3.
  # notifier_poll_seconds: 3

  # Auto-decompose triage tasks each dispatcher tick (opt-in). Default: false.
  # auto_decompose: false

  # LLM decomposition cap per tick. Default: 3.
  # auto_decompose_per_tick: 3

  # Profile for decomposition; empty = active default. Default: "".
  # orchestrator_profile: ""

  # Fallback assignee; empty = active default. Default: "".
  # default_assignee: ""

  # Model for decomposer; empty = auxiliary.kanban_decomposer then main. Default: "".
  # decomposer_model: ""

  # Auto-promote decomposed children with no blockers to ready. Default: true.
  # auto_promote_children: true

  # Model for goal-mode judge; empty = auxiliary.kanban_judge then main. Default: "".
  # judge_model: ""

  # Inner-loop iteration cap for goal-mode workers (F-03). Default: 10.
  # goal_inner_max_iterations: 10

# --- Dashboard ---
# Phase 36.3.7.11 D-17: dashboard tail consumer configuration.
dashboard:
  # kanban:
  #   # Tail consumer polling interval in milliseconds. Default: 250 ms.
  #   tail_interval_ms: 250

# --- TTS (Text-to-Speech) ---
# Phase 36.17.5 D-12: TTS provider configuration.
tts:
  # Active TTS provider. Supported: "edge" (Microsoft Edge TTS), "elevenlabs". Default: "edge".
  # provider: "edge"

  # Optional path to ffmpeg binary for MP3→Opus conversion. null = auto-detect. Default: null.
  # ffmpeg_path: null

  # Edge TTS provider settings
  # edge:
  #   # Edge TTS voice name. Default: "en-US-AriaNeural".
  #   voice: "en-US-AriaNeural"
  #   # Audio output format. Default: "mp3".
  #   output_format: "mp3"

  # ElevenLabs provider settings (requires ELEVENLABS_API_KEY in .env)
  # elevenlabs:
  #   # ElevenLabs voice ID. Default: "pNInz6obpgDQGcFmaJgB" (Adam voice).
  #   voice_id: "pNInz6obpgDQGcFmaJgB"
  #   # ElevenLabs model ID. Default: "eleven_multilingual_v2".
